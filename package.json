{
  "name": "radius",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Radius Principle: write expect.yml, implement against it, then measure drift.",
  "license": "MIT",
  "scripts": {
    "test": "node --test skills/radius-drift/scripts/check-expect.test.mjs skills/radius-expect/scripts/validate-expect.test.mjs scripts/*.test.mjs",
    "check-expect": "node skills/radius-drift/scripts/check-expect.mjs",
    "validate-expect": "node skills/radius-expect/scripts/validate-expect.mjs",
    "site": "python3 -m http.server 4174 --directory site",
    "install-local": "node scripts/install-local.mjs",
    "publish": "node scripts/publish.mjs",
    "publish:push": "node scripts/publish.mjs --push",
    "deploy:skills": "node scripts/deploy-skills.mjs",
    "deploy:site": "node scripts/deploy-site.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.151.3"
  },
  "allowScripts": {
    "workerd@1.20261019.1": true
  }
}
